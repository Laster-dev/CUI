<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Vertical" background="#1E1E1E">
    <!-- 自定义窗口标题栏组件 -->
    <TitleBar id="appTitleBar" title="CUI Control Gallery | 17 大全套控件嵌入式模组 Showcase"/>

    <!-- 主 View 框架：采用嵌套子页 src 嵌入式 TabView，展示全部 17 个控件与布局面板 -->
    <TabView id="mainTabView" flexGrow="1">
        <!-- 基础与高级控件 10 个 -->
        <TabItem header="Button 按钮" icon="[B]" src="page_button.xml"/>
        <TabItem header="TextBlock 文本" icon="[T]" src="page_textblock.xml"/>
        <TabItem header="TextBox 输入框" icon="[I]" src="page_textbox.xml"/>
        <TabItem header="CheckBox 复选框" icon="[C]" src="page_checkbox.xml"/>
        <TabItem header="ComboBox 下拉框" icon="[X]" src="page_combobox.xml"/>
        <TabItem header="ListBox (100k)" icon="[L]" src="page_listbox.xml"/>
        <TabItem header="ListView (100k)" icon="[V]" src="page_listview.xml"/>
        <TabItem header="Hyperlink 超链接" icon="[H]" src="page_hyperlink.xml"/>
        <TabItem header="1000+ FPS 动态推流" icon="[S]" src="page_image_stream.xml"/>
        <TabItem header="ContentDialog 弹窗" icon="[D]" src="page_dialog.xml"/>

        <!-- WPF Layout 布局控件 7 个 -->
        <TabItem header="Grid 网格布局" icon="[G]" src="page_grid.xml"/>
        <TabItem header="Canvas 画布" icon="[A]" src="page_canvas.xml"/>
        <TabItem header="WrapPanel 流式布局" icon="[W]" src="page_wrappanel.xml"/>
        <TabItem header="DockPanel 侧边停靠" icon="[K]" src="page_dockpanel.xml"/>
        <TabItem header="UniformGrid 等分网格" icon="[U]" src="page_uniformgrid.xml"/>
        <TabItem header="StackPanel 线性布局" icon="[P]" src="page_stackpanel.xml"/>
        <TabItem header="ScrollViewer 滚动容器" icon="[R]" src="page_scrollviewer.xml"/>
    </TabView>
</StackPanel>
