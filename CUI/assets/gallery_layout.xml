<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Vertical" background="#1E1E1E">
    <!-- Gallery Top Header -->
    <StackPanel orientation="Horizontal" height="40" background="#252526" padding="12, 0, 12, 0">
        <TextBlock text="CUI Control Gallery" fontSize="15" fontWeight="Bold" color="#FFFFFF" align="Center"/>
        <TextBlock text="  |  Step-by-Step Interactive Component Showcase" fontSize="12" color="#858585" align="Center"/>
    </StackPanel>

    <!-- Main Content Area: Left Navigation Bar + Right Showcase Area -->
    <StackPanel orientation="Horizontal" flexGrow="1">
        <!-- Left Categories & Control List -->
        <StackPanel orientation="Vertical" width="220" background="#252526" padding="8, 12, 8, 12" gap="4">
            <TextBlock text="BASIC INPUT CONTROLS" fontSize="11" fontWeight="Bold" color="#858585" margin="8, 4, 0, 4"/>
            <Button id="btnNavButton" text="  [1] Button" background="#007ACC" color="#FFFFFF" height="28" align="Stretch"/>
            <Button id="btnNavTextBlock" text="  [2] TextBlock" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavTextBox" text="  [3] TextBox" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavCheckBox" text="  [4] CheckBox" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavHyperlink" text="  [5] HyperlinkButton" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavComboBox" text="  [6] ComboBox" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavListBox" text="  [7] ListBox (100k Virtual)" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavListView" text="  [8] ListView (RubberBand)" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>

            <TextBlock text="LAYOUT & CONTAINERS" fontSize="11" fontWeight="Bold" color="#858585" margin="8, 12, 0, 4"/>
            <Button id="btnNavPanel" text="  [4] StackPanel" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
            <Button id="btnNavScroll" text="  [5] ScrollViewer" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>

            <TextBlock text="VS CODE COMPONENTS" fontSize="11" fontWeight="Bold" color="#858585" margin="8, 12, 0, 4"/>
            <Button id="btnNavVSCode" text="  [6] VS Code Full IDE" background="#2D2D2D" color="#CCCCCC" height="28" align="Stretch"/>
        </StackPanel>

        <!-- Right Main Showcase Area (Center Preview + Right Options Inspector) -->
        <StackPanel orientation="Horizontal" flexGrow="1">
            <!-- Center Preview Canvas & Logs -->
            <StackPanel orientation="Vertical" flexGrow="1" padding="16, 16, 16, 16" gap="16">
                <!-- Header: Control Title & Description -->
                <StackPanel orientation="Vertical" gap="4">
                    <TextBlock id="txtControlTitle" text="Button Control Showcase" fontSize="20" fontWeight="Bold" color="#FFFFFF"/>
                    <TextBlock id="txtControlDesc" text="Interactive buttons with normal, hover, pressed states and event callbacks." fontSize="12" color="#AAAAAA"/>
                </StackPanel>

                <!-- 1. Live Interactive Preview Canvas -->
                <StackPanel orientation="Vertical" background="#252526" padding="16, 16, 16, 16" gap="12" borderBrush="#333333" borderThickness="1">
                    <TextBlock text="INTERACTIVE PREVIEW" fontSize="11" fontWeight="Bold" color="#007ACC"/>
                    <StackPanel id="previewCanvas" orientation="Horizontal" gap="12" align="Center">
                        <Button id="demoBtnPrimary" text="Primary Button" background="#007ACC" hoverBackground="#0098FF" pressedBackground="#005A9E" padding="12,6,12,6"/>
                        <Button id="demoBtnSecondary" text="Secondary Button" background="#3C3C3C" hoverBackground="#4C4C4C" pressedBackground="#2C2C2C" padding="12,6,12,6"/>
                        <Button id="demoBtnIcon" text="Icon Button" icon="[+]" background="#0E639C" hoverBackground="#1177BB" padding="12,6,12,6"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. XML DSL Code Preview & Realtime Live Edit -->
                <StackPanel orientation="Vertical" background="#1E1E1E" padding="12, 12, 12, 12" gap="8" borderBrush="#333333" borderThickness="1" cornerRadius="4">
                    <TextBlock text="XML MARKUP DESCRIPTOR (LIVE EDITABLE)" fontSize="11" fontWeight="Bold" color="#569CD6"/>
                    <TextBox id="txtXmlPreview" text="&lt;Button text=&quot;Primary Button&quot; background=&quot;#007ACC&quot; cornerRadius=&quot;4&quot;/&gt;" fontSize="12" fontFamily="Consolas" color="#CE9178" width="600" height="34" cornerRadius="4"/>
                </StackPanel>

                <!-- 3. Event & Property Inspector Log -->
                <StackPanel orientation="Vertical" flexGrow="1" background="#1E1E1E" padding="12, 12, 12, 12" gap="6" borderBrush="#333333" borderThickness="1">
                    <TextBlock text="EVENT LOG &amp; PROPERTY INSPECTOR" fontSize="11" fontWeight="Bold" color="#4EC9B0"/>
                    <TextBlock id="txtEventLog" text="[Ready] Click any button above to test interactive events..." fontSize="12" fontFamily="Consolas" color="#B5CEA8"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Options & Properties Inspector Panel -->
            <StackPanel orientation="Vertical" width="220" background="#252526" padding="12, 16, 12, 16" gap="10" borderBrush="#333333" borderThickness="1">
                <TextBlock text="OPTIONS / PROPERTIES" fontSize="11" fontWeight="Bold" color="#569CD6" margin="0, 4, 0, 4"/>
                
                <TextBlock text="IsEnabled State" fontSize="11" color="#AAAAAA"/>
                <CheckBox id="chkOptIsEnabled" text="IsEnabled" checkState="Checked"/>

                <TextBlock text="Header / Text" fontSize="11" color="#AAAAAA"/>
                <TextBox id="txtOptText" text="Control header" width="190" height="30" cornerRadius="4"/>

                <TextBlock text="CornerRadius (px)" fontSize="11" color="#AAAAAA"/>
                <TextBox id="txtOptRadius" text="4" width="190" height="30" cornerRadius="4"/>

                <TextBlock text="Accent Theme Color" fontSize="11" color="#AAAAAA"/>
                <ComboBox id="comboOptTheme" width="190"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>

    <!-- Bottom Status Bar -->
    <StatusBar id="statusBar"/>
</StackPanel>
