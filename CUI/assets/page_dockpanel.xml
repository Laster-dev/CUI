<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="DockPanel 侧边停靠控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持 Top/Bottom/Left/Right 侧边停靠与中央填充。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" background="#252526" padding="16" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <DockPanel id="targetDock" width="420" height="240">
                <Button text="Top 顶部" DockPanel.Dock="Top" height="36" background="#007ACC"/>
                <Button text="Bottom 底部" DockPanel.Dock="Bottom" height="32" background="#10B981"/>
                <Button text="Left 左侧" DockPanel.Dock="Left" width="100" background="#8E44AD"/>
                <Button text="Center 中央填充" background="#D13438"/>
            </DockPanel>
        </StackPanel>
    </StackPanel>

    <StackPanel orientation="Vertical" width="320" background="#252526" padding="16" gap="10" borderBrush="#333333" borderThickness="1">
        <TextBlock text="停靠面板属性表 (DockPanel)" fontSize="12" fontWeight="Bold" color="#569CD6"/>

        <CheckBox id="chkLastChildFill" text="末尾填充 (LastChildFill)" checkState="Checked"/>
    </StackPanel>
</StackPanel>
