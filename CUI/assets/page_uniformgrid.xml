<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="UniformGrid 等分网格控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="等比例切割网格，所有子元素自动平分空间。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" background="#252526" padding="16" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <UniformGrid id="targetUg" rows="2" columns="3" width="420" height="240">
                <Button text="单元格 #1" background="#007ACC"/>
                <Button text="单元格 #2" background="#007ACC"/>
                <Button text="单元格 #3" background="#007ACC"/>
                <Button text="单元格 #4" background="#007ACC"/>
                <Button text="单元格 #5" background="#007ACC"/>
                <Button text="单元格 #6" background="#007ACC"/>
            </UniformGrid>
        </StackPanel>
    </StackPanel>

    <StackPanel orientation="Vertical" width="320" background="#252526" padding="16" gap="10" borderBrush="#333333" borderThickness="1">
        <TextBlock text="等分网格属性表 (UniformGrid)" fontSize="12" fontWeight="Bold" color="#569CD6"/>

        <TextBlock text="行数 (Rows):" fontSize="11" color="#AAAAAA"/>
        <TextBox id="inputUgRows" text="2" width="280" height="26"/>

        <TextBlock text="列数 (Columns):" fontSize="11" color="#AAAAAA"/>
        <TextBox id="inputUgCols" text="3" width="280" height="26"/>
    </StackPanel>
</StackPanel>
