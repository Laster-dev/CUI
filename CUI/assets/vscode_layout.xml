<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Vertical" background="#1F1F1F">
    <!-- Top Custom TitleBar -->
    <TitleBar id="mainTitleBar" styleClass="vscode-titlebar" title="{Binding Path=AppTitle}"/>

    <!-- Main Workspace Area (Horizontal: ActivityBar + SideBar + Main Editor Area) -->
    <StackPanel orientation="Horizontal" flexGrow="1">
        <!-- Left Activity Bar -->
        <ActivityBar id="activityBar" styleClass="vscode-activitybar"/>

        <!-- Left Explorer SideBar -->
        <SideBar id="sideBar" styleClass="vscode-sidebar" title="EXPLORER: CUI PROJECT"/>

        <!-- Center Main Content (Vertical: TabBar + EditorView) -->
        <StackPanel orientation="Vertical" flexGrow="1" styleClass="vscode-editor">
            <!-- Editor TabBar -->
            <TabBar id="tabBar" styleClass="vscode-tabbar"/>

            <!-- Main Text Editor View -->
            <EditorView id="editorView" flexGrow="1"/>
        </StackPanel>
    </StackPanel>

    <!-- Bottom Status Bar -->
    <StatusBar id="statusBar" styleClass="vscode-statusbar"/>
</StackPanel>
