<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="StackPanel 线性布局控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="实时修改布局方向 (Orientation) 与 元素间距 (Gap)。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" background="#252526" padding="16" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <StackPanel id="targetSp" orientation="Horizontal" gap="12" width="420" height="220">
                <Button text="弹性元素 #1" background="#007ACC" padding="14,8,14,8"/>
                <Button text="弹性元素 #2" background="#10B981" padding="14,8,14,8"/>
                <Button text="弹性元素 #3" background="#D13438" padding="14,8,14,8"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>

    <StackPanel orientation="Vertical" width="320" background="#252526" padding="16" gap="10" borderBrush="#333333" borderThickness="1">
        <TextBlock text="线性面板属性表 (StackPanel)" fontSize="12" fontWeight="Bold" color="#569CD6"/>

        <TextBlock text="布局方向 (Orientation):" fontSize="11" color="#AAAAAA"/>
        <ComboBox id="comboOrient" width="280"/>

        <TextBlock text="元素间距 (Gap) [px]:" fontSize="11" color="#AAAAAA"/>
        <TextBox id="inputGap" text="12" width="280" height="26"/>
    </StackPanel>
</StackPanel>
