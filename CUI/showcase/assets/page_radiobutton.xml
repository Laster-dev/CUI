<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="RadioButton 单选框控件" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持 GroupName 互斥分组逻辑，同组内切换自动取消其他选项。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="24" cornerRadius="6" borderBrush="#333333" borderThickness="1" gap="12">
            <RadioButton id="targetRadio" text="选项 1 (Option A)" groupName="DemoGroup" isChecked="true"/>
            <RadioButton text="选项 2 (Option B)" groupName="DemoGroup"/>
            <RadioButton text="选项 3 (Option C)" groupName="DemoGroup"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridRadio" width="320"/>
</StackPanel>
