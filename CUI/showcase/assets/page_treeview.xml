<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="TreeView 树形视图控件 (支持层级折叠/展开与多项交互)" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="高效层级树结构控件，支持展开/折叠箭头、图标、键盘上下左右导航与属性表实时响应。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="16" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <TreeView id="targetTree" width="300" height="360"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridTree" width="320"/>
