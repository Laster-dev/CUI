<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="HyperlinkButton 超链接按钮全属性控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="带有 Hover 下划线特效与网页 URL 导航交互。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="40" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <HyperlinkButton id="targetLink" text="访问 GitHub 官方主页" navigateUri="https://github.com"/>
        </StackPanel>
    </StackPanel>

    <ScrollViewer width="320" background="#252526" borderBrush="#333333" borderThickness="1">
        <StackPanel orientation="Vertical" padding="16" gap="8">
            <TextBlock text="超链接属性控制表 (Hyperlink)" fontSize="12" fontWeight="Bold" color="#569CD6"/>

            <TextBlock text="跳转网址 (NavigateUri):" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputUrl" text="https://github.com" width="280" height="26"/>

            <TextBlock text="显示文本 (Text):" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputLinkText" text="访问 GitHub 官方主页" width="280" height="26"/>

            <CheckBox id="chkLinkEnabled" text="是否启用 (IsEnabled)" checkState="Checked"/>

            <TextBlock text="字体大小 (FontSize):" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputLinkFontSize" text="14" width="280" height="26"/>

            <TextBlock text="显式宽度 (Width) [-1自适应]:" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputLinkWidth" text="-1" width="280" height="26"/>

            <TextBlock text="显式高度 (Height) [-1自适应]:" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputLinkHeight" text="-1" width="280" height="26"/>

            <TextBlock text="外边距 (Margin):" fontSize="11" color="#AAAAAA"/>
            <TextBox id="inputLinkMargin" text="0,0,0,0" width="280" height="26"/>
        </StackPanel>
    </ScrollViewer>
</StackPanel>
