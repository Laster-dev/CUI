<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="Slider 滑块控件" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持水平与垂直方向、Step 步长约束、键盘上下左右微调与数值变动事件。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="24" cornerRadius="6" borderBrush="#333333" borderThickness="1" gap="16">
            <Slider id="targetSlider" value="45" width="280" height="24"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridSlider" width="320"/>
</StackPanel>
