<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="CollapsePanel 可折叠手风琴面板控件" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持点击标题栏展开/收起子容器、自定义 Header 文本与动画过渡。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" background="#252526" padding="20" cornerRadius="6" borderBrush="#333333" borderThickness="1" gap="16">
            <CollapsePanel id="targetCollapse1" header="1. 基础视图配置 (Basic Settings)" isExpanded="true">
                <StackPanel orientation="Vertical" gap="8">
                    <CheckBox text="启用自动同步云端配置文件"/>
                    <CheckBox text="显示系统底栏状态通知"/>
                    <Button text="应用当前基础配置" width="160" height="26"/>
                </StackPanel>
            </CollapsePanel>

            <CollapsePanel id="targetCollapse2" header="2. 高级硬件加速选项 (Advanced Options)" isExpanded="false">
                <StackPanel orientation="Vertical" gap="8">
                    <ToggleSwitch header="开启 Direct2D 独立多线程硬件渲染" isOn="true"/>
                    <Slider value="75" width="240" height="24"/>
                </StackPanel>
            </CollapsePanel>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridCollapse" width="320"/>
</StackPanel>
