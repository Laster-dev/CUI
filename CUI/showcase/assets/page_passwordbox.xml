<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="PasswordBox 密码输入框控件全属性 Showcase" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="继承自 TextBox，支持自动字符掩盖 (•) 与右侧眼睛图标 (Eye Icon) 明文/密文切换。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="30" cornerRadius="6" borderBrush="#333333" borderThickness="1" gap="16">
            <PasswordBox id="targetPasswordBox" placeholder="请输入您的账号密码" toolTip="悬停提示: 点击右侧眼睛图标切换明文/密文" width="320" height="42"/>
            <TextBlock text="提示: 悬停在上方的 PasswordBox 上可观察随鼠标移动的 ToolTip 悬浮卡片效果。" fontSize="12" color="#569CD6"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridPwd" width="320"/>
</StackPanel>
