<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="PagingControl 数据表格/列表分页条控件" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持页码快速切换、上一页/下一页导航与总页数约束。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="24" cornerRadius="6" borderBrush="#333333" borderThickness="1" gap="16">
            <PagingControl id="targetPaging" currentPage="1" totalPages="10"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridPaging" width="320"/>
</StackPanel>
