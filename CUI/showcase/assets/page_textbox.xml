<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="TextBox 输入框控件全属性控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持光标颜色/宽度/闪烁周期自定义、占位词与高级排版。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" alignHorizontal="Center" background="#252526" padding="30" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <TextBox id="targetTb" text="在此输入多行文本..." width="320" height="120" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
    </StackPanel>

    <PropertyGrid id="propGridTb" width="320"/>
</StackPanel>
