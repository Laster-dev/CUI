<?xml version="1.0" encoding="utf-8"?>
<StackPanel orientation="Horizontal" flexGrow="1">
    <StackPanel orientation="Vertical" flexGrow="1" padding="20" gap="16" background="#1E1E1E">
        <StackPanel orientation="Vertical" gap="4">
            <TextBlock text="Canvas 绝对定位画布控制台" fontSize="18" fontWeight="Bold" color="#FFFFFF"/>
            <TextBlock text="支持附加属性 Canvas.Left 与 Canvas.Top 自由坐标平移。" fontSize="12" color="#888888"/>
        </StackPanel>

        <StackPanel orientation="Vertical" background="#252526" padding="16" cornerRadius="6" borderBrush="#333333" borderThickness="1">
            <Canvas id="targetCanvas" width="460" height="240">
                <Button id="targetCanvasBtn" text="绝对坐标定位元素" Canvas.Left="40" Canvas.Top="50" background="#007ACC" padding="14,8,14,8"/>
            </Canvas>
        </StackPanel>
    </StackPanel>

    <StackPanel orientation="Vertical" width="320" background="#252526" padding="16" gap="10" borderBrush="#333333" borderThickness="1">
        <TextBlock text="画布附加属性表 (Canvas)" fontSize="12" fontWeight="Bold" color="#569CD6"/>

        <TextBlock text="横坐标 (Canvas.Left) [px]:" fontSize="11" color="#AAAAAA"/>
        <TextBox id="inputCanvasLeft" text="40" width="280" height="26"/>

        <TextBlock text="纵坐标 (Canvas.Top) [px]:" fontSize="11" color="#AAAAAA"/>
        <TextBox id="inputCanvasTop" text="50" width="280" height="26"/>
    </StackPanel>
</StackPanel>
